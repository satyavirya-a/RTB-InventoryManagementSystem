# File dan folder yang TIDAK boleh masuk ke Git

# Environment variables — berisi secret keys!
# Kalau file ini ter-commit, siapa pun bisa akses database Supabase kamu.
.env
.env.local
.env.*.local

# Folder hasil build produksi (bisa di-generate ulang kapan saja)
dist/

# Dependencies (bisa diinstall ulang dengan `npm install`)
node_modules/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & editor files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
