# Environment Variables — Gudang RTB
# =====================================
# PENTING: File ini TIDAK boleh masuk Git! (sudah ada di .gitignore)
# Salin file ini menjadi .env.local lalu isi dengan nilai asli dari dashboard Supabase.
#
# Cara mendapatkan nilai ini:
# 1. Buka https://app.supabase.com
# 2. Pilih project kamu
# 3. Buka Settings → API
# 4. Salin "Project URL" dan "anon public" key

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# (Opsional) Google Apps Script Webhook URL untuk Auto-Backup ke Google Sheets & Google Drive
# Dapatkan URL ini setelah melakukan deploy script docs/google-apps-script.js sebagai Web App
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
